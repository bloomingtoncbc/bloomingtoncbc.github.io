---
import Page from '../../layouts/Page.astro';
import { AREA_STAFFING, COVERAGE_GROUPS, STAFFING_SUMMARY } from '../../data/areaStaffing';

const CBC_SCOUT_URL = 'https://lizstanley.com/birdspotter/cbc/scout/';
const PRINTABLE_MAPS_URL = 'https://drive.google.com/drive/folders/1MiNkOi9EYoEUPBSr-2HbV_SZ5tvjQHt1?usp=sharing';

const half = Math.ceil(AREA_STAFFING.length / 2);
const leftColumn = AREA_STAFFING.slice(0, half);
const rightColumn = AREA_STAFFING.slice(half);
---

<Page title="Count Circle Maps" wide>
	<p>
		The Bloomington count circle is centered at the intersection of Hwy 77 and Hwy 13 (latitude: 44.8127, longitude:
		-93.2199). It is a very complex circle, divided into 24 areas. (Note that as of 2024, we have divided Areas 1, 2, 3,
		and 20 in half to create 4 new areas.)
	</p>
	<p>
		Pick an area on either side of the map, or click it on the map, to see just that area and how it's best covered.{' '}
		<strong>Show All Areas</strong> brings back the whole circle. <a href={PRINTABLE_MAPS_URL}>Printable PDF versions</a> of
		the area maps are also available to download. To keep track of where you are while counting, use the{' '}
		<a href="#cbc-scout">CBC Scout</a> app on your phone.
	</p>

	<div class="circle-maps">
		<ul class="area-links">
			<li>
				<button type="button" class="button-link" data-select-area="all" aria-pressed="true">Show All Areas</button>
			</li>
			{
				leftColumn.map(({ area }) => (
					<li>
						<button type="button" class="button-link" data-select-area={area} aria-pressed="false">
							Area {area}
						</button>
					</li>
				))
			}
		</ul>
		<div class="circle-map" id="circle-map" role="region" aria-label="Map of the Bloomington count circle and its 24 areas">
		</div>
		<ul class="area-links">
			{
				rightColumn.map(({ area }) => (
					<li>
						<button type="button" class="button-link" data-select-area={area} aria-pressed="false">
							Area {area}
						</button>
					</li>
				))
			}
		</ul>
	</div>
	<p class="embed-caption">
		The gray, dashed area at the north edge of the circle is counted by the St. Paul CBC, not by us.
	</p>

	<section class="area-detail" data-area-detail="all" aria-live="polite">
		<h2>Covering the circle</h2>
		<p>
			To cover all 24 areas without overlapping parties, <strong>{STAFFING_SUMMARY.counters} field counters</strong> ({
				STAFFING_SUMMARY.parties
			} parties) are ideal. The numbers for each area come from its size, whether it's mostly trails or roads, and how its
			eBird hotspots cluster. Pick an area for its details.
		</p>
		<dl class="coverage-groups">
			{
				COVERAGE_GROUPS.map((group) => (
					<div>
						<dt>{group.title}</dt>
						<dd>
							<p>{group.description}</p>
							<p class="area-chips">
								{group.areas.map((area) => (
									<button type="button" class="area-chip" data-select-area={area}>
										Area {area}
									</button>
								))}
							</p>
						</dd>
					</div>
				))
			}
		</dl>
	</section>

	{
		AREA_STAFFING.map((a) => (
			<section class="area-detail" data-area-detail={a.area} hidden>
				<h2>Area {a.area}</h2>
				<dl class="area-stats">
					<div>
						<dt>Size</dt>
						<dd>{a.squareMiles.toFixed(2)} sq. mi.</dd>
					</div>
					<div>
						<dt>eBird hotspots</dt>
						<dd>{a.hotspots}</dd>
					</div>
					<div>
						<dt>Ideal counters</dt>
						<dd>
							{a.counters} ({a.parties})
						</dd>
					</div>
					<div>
						<dt>Recommended mode</dt>
						<dd>{a.mode}</dd>
					</div>
				</dl>
				<p>{a.rationale}</p>
			</section>
		))
	}

	<hr />

	<h2 id="cbc-scout">CBC Scout: your area on your phone</h2>
	<p>
		<a href={CBC_SCOUT_URL}>CBC Scout</a> is a free phone app for our field counters. It shows your area on a map and
		where you are, so you can tell whether you're inside your area, outside it, or outside the circle. It also shows
		what's been seen nearby and suggests places to visit in your area. On count day it can record your party's hours and
		miles, by vehicle and by foot, and send them as the line for your count sheet. There's no account to make, and
		nothing about you leaves your phone.
	</p>
	<ol>
		<li>
			<strong>Install it.</strong> Open <a href={CBC_SCOUT_URL}>{CBC_SCOUT_URL}</a> on your phone. On iPhone, tap{' '}
			<strong>Share</strong> in Safari, then <strong>Add to Home Screen</strong>. On Android, tap <strong>Install</strong>{' '}
			on the bar at the top in Chrome.
		</li>
		<li>
			<strong>Add an eBird key.</strong> The first screen asks for a free eBird API key and links to the page where you
			request one. It's used for the nearby sightings and hotspots.
		</li>
		<li>
			<strong>Load your area.</strong> I'll send you a link or a QR code for your area. Open the link, or in the app open{' '}
			<strong>Your areas</strong> from the menu and tap <strong>Scan area code</strong> or <strong>Paste link</strong>.
		</li>
	</ol>
	<p>
		CBC Scout needs a cell signal to show the map. Keep using our <a href="/count-info/count-sheet/">official count
		sheet</a> for your birds.
	</p>
</Page>

<script>
	import maplibregl, { type FilterSpecification, type LngLatBoundsLike } from 'maplibre-gl';
	import 'maplibre-gl/dist/maplibre-gl.css';
	import circleAreas from '../../data/circle-areas.json';

	// OpenFreeMap's style carries the attribution its terms require; MapLibre shows it.
	const BASEMAP_STYLE_URL = 'https://tiles.openfreemap.org/styles/liberty';
	const ALL = 'all';
	const AREA_HASH = /^#area-(\d+)$/;

	type Ring = readonly (readonly number[])[];

	function boundsOf(rings: readonly Ring[]): LngLatBoundsLike {
		const points = rings.flat();
		const lngs = points.map(([lng]) => lng);
		const lats = points.map(([, lat]) => lat);
		return [Math.min(...lngs), Math.min(...lats), Math.max(...lngs), Math.max(...lats)];
	}

	// Area-weighted centroid of the outer ring, where the area number label sits.
	function labelPoint(ring: Ring): [number, number] {
		let twiceArea = 0;
		let x = 0;
		let y = 0;
		for (let i = 0; i < ring.length - 1; i += 1) {
			const [x0, y0] = ring[i];
			const [x1, y1] = ring[i + 1];
			const cross = x0 * y1 - x1 * y0;
			twiceArea += cross;
			x += (x0 + x1) * cross;
			y += (y0 + y1) * cross;
		}
		return [x / (3 * twiceArea), y / (3 * twiceArea)];
	}

	const features = circleAreas.features;
	const outerCircle = features.find((f) => f.properties.kind === 'circle');
	if (!outerCircle) throw new Error('maps: circle-areas.json has no outer circle');
	const areaRings = new Map(
		features.filter((f) => f.properties.area).map((f) => [f.properties.area as string, f.geometry.coordinates]),
	);
	const circleBounds = boundsOf(outerCircle.geometry.coordinates);
	const labels: GeoJSON.FeatureCollection = {
		type: 'FeatureCollection',
		features: [...areaRings].map(([area, rings]) => ({
			type: 'Feature',
			properties: { area },
			geometry: { type: 'Point', coordinates: labelPoint(rings[0]) },
		})),
	};

	const map = new maplibregl.Map({
		container: 'circle-map',
		style: BASEMAP_STYLE_URL,
		bounds: circleBounds,
		fitBoundsOptions: { padding: 20 },
		cooperativeGestures: true,
	});
	map.addControl(new maplibregl.NavigationControl({ showCompass: false }));

	function areaFilter(selected: string): FilterSpecification {
		return selected === ALL
			? ['==', ['get', 'kind'], 'area']
			: ['all', ['==', ['get', 'kind'], 'area'], ['==', ['get', 'area'], selected]];
	}

	function showSelection(selected: string) {
		for (const button of document.querySelectorAll<HTMLButtonElement>('.area-links [data-select-area]')) {
			button.setAttribute('aria-pressed', String(button.dataset.selectArea === selected));
		}
		for (const panel of document.querySelectorAll<HTMLElement>('[data-area-detail]')) {
			panel.hidden = panel.dataset.areaDetail !== selected;
		}
		if (!map.getLayer('area-fill')) return;
		const notCountedVisibility = selected === ALL ? 'visible' : 'none';
		map.setFilter('area-fill', areaFilter(selected));
		map.setFilter('area-line', areaFilter(selected));
		map.setFilter('area-label', selected === ALL ? null : ['==', ['get', 'area'], selected]);
		map.setLayoutProperty('not-counted-fill', 'visibility', notCountedVisibility);
		map.setLayoutProperty('not-counted-line', 'visibility', notCountedVisibility);
		const rings = areaRings.get(selected);
		map.fitBounds(rings ? boundsOf(rings) : circleBounds, { padding: 40, maxZoom: 14 });
	}

	function selectionFromHash(): string {
		const area = AREA_HASH.exec(window.location.hash)?.[1];
		return area && areaRings.has(area) ? area : ALL;
	}

	function select(selected: string) {
		const hash = selected === ALL ? '' : `#area-${selected}`;
		history.replaceState(null, '', `${window.location.pathname}${window.location.search}${hash}`);
		showSelection(selected);
		const mapTop = map.getContainer().getBoundingClientRect().top;
		if (mapTop < 0 || mapTop > window.innerHeight / 2) {
			map.getContainer().scrollIntoView({ behavior: 'smooth', block: 'start' });
		}
	}

	map.on('load', () => {
		map.addSource('areas', { type: 'geojson', data: circleAreas as GeoJSON.FeatureCollection });
		map.addSource('area-labels', { type: 'geojson', data: labels });
		map.addLayer({
			id: 'not-counted-fill',
			type: 'fill',
			source: 'areas',
			filter: ['==', ['get', 'kind'], 'not-counted'],
			paint: { 'fill-color': '#64748b', 'fill-opacity': 0.3 },
		});
		map.addLayer({
			id: 'not-counted-line',
			type: 'line',
			source: 'areas',
			filter: ['==', ['get', 'kind'], 'not-counted'],
			paint: { 'line-color': '#475569', 'line-width': 2, 'line-dasharray': [2, 2] },
		});
		map.addLayer({
			id: 'area-fill',
			type: 'fill',
			source: 'areas',
			filter: areaFilter(ALL),
			paint: { 'fill-color': ['get', 'color'], 'fill-opacity': 0.22 },
		});
		map.addLayer({
			id: 'area-line',
			type: 'line',
			source: 'areas',
			filter: areaFilter(ALL),
			paint: { 'line-color': ['get', 'color'], 'line-width': 2.5 },
		});
		map.addLayer({
			id: 'circle-line',
			type: 'line',
			source: 'areas',
			filter: ['==', ['get', 'kind'], 'circle'],
			paint: { 'line-color': '#1e293b', 'line-width': 3 },
		});
		map.addLayer({
			id: 'area-label',
			type: 'symbol',
			source: 'area-labels',
			layout: {
				'text-field': ['get', 'area'],
				'text-font': ['Noto Sans Bold'],
				'text-size': 16,
				'text-allow-overlap': true,
			},
			paint: { 'text-color': '#212121', 'text-halo-color': '#ffffff', 'text-halo-width': 2 },
		});
		showSelection(selectionFromHash());
	});

	map.on('click', 'area-fill', (event) => {
		const area = event.features?.[0]?.properties.area;
		if (typeof area === 'string') select(area);
	});
	map.on('mouseenter', 'area-fill', () => {
		map.getCanvas().style.cursor = 'pointer';
	});
	map.on('mouseleave', 'area-fill', () => {
		map.getCanvas().style.cursor = '';
	});

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-select-area]')) {
		button.addEventListener('click', () => select(button.dataset.selectArea ?? ALL));
	}
	window.addEventListener('hashchange', () => showSelection(selectionFromHash()));
	showSelection(selectionFromHash());
</script>

<style>
	.circle-maps {
		display: grid;
		grid-template-columns: 11rem 1fr 11rem;
		gap: 1.75rem;
		align-items: stretch;
		margin: 2rem 0 1.5rem;
	}

	.area-links {
		display: grid;
		align-content: start;
		gap: 0.9rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.area-links li {
		margin: 0;
	}

	.area-links .button-link {
		width: 100%;
		border: 2px solid transparent;
		font: inherit;
		cursor: pointer;
	}

	.area-links .button-link[aria-pressed='true'] {
		border-color: var(--ink);
		font-weight: 700;
	}

	.circle-map {
		min-height: 660px;
		scroll-margin-top: calc(var(--nav-height) + 0.75rem);
		border-radius: 4px;
		overflow: hidden;
	}

	.area-detail {
		margin: 0 0 2rem;
		padding: 1.25rem 1.5rem;
		background: #fff;
		border-left: 4px solid var(--red);
		border-radius: 4px;
	}

	.area-detail h2 {
		margin-top: 0;
	}

	.area-stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 1rem;
		margin: 0 0 1rem;
	}

	.area-stats dt,
	.coverage-groups dt {
		font-weight: 700;
	}

	.area-stats dd {
		margin: 0;
	}

	.coverage-groups {
		display: grid;
		gap: 1rem;
		margin: 0;
	}

	.coverage-groups dd {
		margin: 0;
	}

	.coverage-groups dd p {
		margin: 0.25rem 0;
	}

	.area-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.area-chip {
		padding: 0.15rem 0.6rem;
		font: inherit;
		font-size: 0.9rem;
		background: var(--gold);
		color: var(--ink);
		border: 0;
		border-radius: 999px;
		cursor: pointer;
	}

	.area-chip:hover {
		background: #ffca28;
	}

	@media (max-width: 820px) {
		.circle-maps {
			grid-template-columns: 1fr 1fr;
		}

		.circle-maps .circle-map {
			grid-column: 1 / -1;
			grid-row: 1;
			min-height: 480px;
		}
	}
</style>
