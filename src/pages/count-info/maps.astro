---
import AreaDetails from '../../components/AreaDetails.astro';
import CircleStaffing from '../../components/CircleStaffing.astro';
import { areaMapName, areaMapPdfPath, CIRCLE_MAP_NAME } from '../../data/areaMapFiles';
import { AREA_STAFFING } from '../../data/areaStaffing';
import Page from '../../layouts/Page.astro';

const CBC_SCOUT_URL = 'https://lizstanley.com/birdspotter/cbc/scout/';
---

<Page title="Count Circle Maps" wide>
	<p>
		The Bloomington count circle is centered at the intersection of Hwy 77 and Hwy 13 (latitude: 44.8127, longitude:
		-93.2199). It is a very complex circle, divided into 24 areas. (Note that as of 2024, we have divided Areas 1, 2, 3,
		and 20 in half to create 4 new areas.)
	</p>
	<p>
		Click an area on the map to see how it's best covered and to download a printable map of it. To keep track of where
		you are while counting, use the <a href="#cbc-scout">CBC Scout</a> app on your phone.
	</p>

	<div class="circle-maps">
		<div class="map-column">
			<div class="circle-map" id="circle-map" role="region" aria-label="Map of the Bloomington count circle and its 24 areas">
			</div>
			<p class="embed-caption">
				The gray, dashed area at the north edge of the circle is counted by the St. Paul CBC, not by us.
			</p>
		</div>

		<div class="area-panel" aria-live="polite">
			<section class="area-detail" data-area-detail="all">
				<h2>Covering the circle</h2>
				<CircleStaffing hasAreaButtons />
				<p class="download">
					<a href={areaMapPdfPath(areaMapName(CIRCLE_MAP_NAME))} download>Download the circle map (PDF)</a>
				</p>
			</section>

			{
				AREA_STAFFING.map((staffing) => (
					<section class="area-detail" data-area-detail={staffing.area} hidden>
						<div class="detail-head">
							<h2>Area {staffing.area}</h2>
							<button type="button" class="show-all" data-select-area="all">
								Show All Areas
							</button>
						</div>
						<AreaDetails staffing={staffing} />
						<p class="download">
							<a href={areaMapPdfPath(areaMapName(staffing.area))} download>
								Download the Area {staffing.area} map (PDF)
							</a>
						</p>
					</section>
				))
			}
		</div>
	</div>

	<hr />

	<h2 id="cbc-scout">CBC Scout: your area on your phone</h2>
	<p>
		<a href={CBC_SCOUT_URL}>CBC Scout</a> is a free phone app for our field counters. It shows your area on a map and
		where you are, so you can tell whether you're inside your area, outside it, or outside the circle. It also shows
		what's been seen nearby and suggests places to visit in your area. On count day it can record your party's hours and
		miles, by vehicle and by foot, and send them as the line for your count sheet. There's no account to make, and
		nothing about you leaves your phone.
	</p>
	<ol>
		<li>
			<strong>Install it.</strong> Open <a href={CBC_SCOUT_URL}>{CBC_SCOUT_URL}</a> on your phone. On iPhone, tap{' '}
			<strong>Share</strong> in Safari, then <strong>Add to Home Screen</strong>. On Android, tap <strong>Install</strong>{' '}
			on the bar at the top in Chrome.
		</li>
		<li>
			<strong>Add an eBird key.</strong> The first screen asks for a free eBird API key and links to the page where you
			request one. It's used for the nearby sightings and hotspots.
		</li>
		<li>
			<strong>Load your area.</strong> I'll send you a link or a QR code for your area. Open the link, or in the app open{' '}
			<strong>Your areas</strong> from the menu and tap <strong>Scan area code</strong> or <strong>Paste link</strong>.
		</li>
	</ol>
	<p>
		CBC Scout needs a cell signal to show the map. Keep using our <a href="/count-info/count-sheet/">official count
		sheet</a> for your birds.
	</p>
</Page>

<script>
	import { ALL_AREAS, createAreaMap, isArea, showArea } from '../../scripts/areaMap';

	const AREA_HASH = /^#area-(\d+)$/;

	function selectionFromHash(): string {
		const area = AREA_HASH.exec(window.location.hash)?.[1];
		return area && isArea(area) ? area : ALL_AREAS;
	}

	const container = document.getElementById('circle-map');
	if (!container) throw new Error('maps: no #circle-map element');
	const map = createAreaMap({ container, initialArea: selectionFromHash(), isInteractive: true });

	function showPanel(selected: string) {
		for (const panel of document.querySelectorAll<HTMLElement>('[data-area-detail]')) {
			panel.hidden = panel.dataset.areaDetail !== selected;
		}
	}

	function select(selected: string) {
		const hash = selected === ALL_AREAS ? '' : `#area-${selected}`;
		history.replaceState(null, '', `${window.location.pathname}${window.location.search}${hash}`);
		showPanel(selected);
		showArea(map, selected);
		const mapTop = container.getBoundingClientRect().top;
		if (mapTop < 0 || mapTop > window.innerHeight / 2) {
			container.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}
	}

	map.on('click', 'area-fill', (event) => {
		const area = event.features?.[0]?.properties.area;
		if (typeof area === 'string') select(area);
	});
	map.on('mouseenter', 'area-fill', () => {
		map.getCanvas().style.cursor = 'pointer';
	});
	map.on('mouseleave', 'area-fill', () => {
		map.getCanvas().style.cursor = '';
	});

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-select-area]')) {
		button.addEventListener('click', () => select(button.dataset.selectArea ?? ALL_AREAS));
	}
	window.addEventListener('hashchange', () => {
		const selected = selectionFromHash();
		showPanel(selected);
		showArea(map, selected);
	});
	showPanel(selectionFromHash());
</script>

<style>
	.circle-maps {
		display: grid;
		grid-template-columns: minmax(0, 1.7fr) minmax(18rem, 1fr);
		gap: 1.5rem;
		align-items: start;
		margin: 2rem 0;
	}

	.map-column .embed-caption {
		margin-top: 0.5rem;
	}

	.circle-map {
		height: 680px;
		border-radius: 4px;
		overflow: hidden;
		scroll-margin-top: calc(var(--nav-height) + 0.75rem);
	}

	.area-detail {
		padding: 1.25rem 1.5rem;
		background: #fff;
		border-left: 4px solid var(--red);
		border-radius: 4px;
	}

	.area-detail h2 {
		margin: 0 0 0.75rem;
	}

	.detail-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1rem;
	}

	.show-all {
		padding: 0.3rem 1rem;
		font: inherit;
		background: var(--gold);
		color: var(--ink);
		border: 0;
		border-radius: 4px;
		cursor: pointer;
	}

	.show-all:hover {
		background: #ffca28;
	}

	.download {
		margin: 1rem 0 0;
		font-weight: 700;
	}

	@media (max-width: 900px) {
		.circle-maps {
			grid-template-columns: 1fr;
		}

		.circle-map {
			height: 480px;
		}
	}
</style>
