---
import { staffingText, type AreaStaffing } from '../data/areaStaffing';
import ScoutQrCode from './ScoutQrCode.astro';

interface Props {
	staffing: AreaStaffing;
}

const { staffing } = Astro.props;
---

<dl class="area-stats">
	<div>
		<dt>Size</dt>
		<dd>{staffing.squareMiles.toFixed(2)} sq. mi.</dd>
	</div>
	<div>
		<dt>eBird hotspots</dt>
		<dd>{staffing.hotspots}</dd>
	</div>
	<div>
		<dt>Minimum</dt>
		<dd>{staffingText(staffing.minimum)}</dd>
	</div>
	<div>
		<dt>Ideal</dt>
		<dd>{staffingText(staffing.ideal)}</dd>
	</div>
	<div class="wide">
		<dt>Recommended mode</dt>
		<dd>{staffing.mode}</dd>
	</div>
</dl>
<p><strong>Minimum:</strong> {staffing.minimumNote}</p>
<p><strong>Ideal:</strong> {staffing.idealNote}</p>
<ScoutQrCode area={staffing.area} />

<style>
	.area-stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem 1rem;
		margin: 0 0 1rem;
	}

	.area-stats .wide {
		grid-column: 1 / -1;
	}

	.area-stats dt {
		font-weight: 700;
	}

	.area-stats dd {
		margin: 0;
	}
</style>
